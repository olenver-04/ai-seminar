{
  "rules": {
    "sessions": {
      "$session": {
        ".read": true,
        ".write": "!newData.exists()",
        "current": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length < 20"
        },
        "revealed": {
          "$work": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          }
        },
        "votes": {
          "$work": {
            "$voter": {
              ".write": true,
              ".validate": "newData.isString() && newData.val().matches(/^(chatgpt|notebooklm|claude)$/) && $voter.length < 40"
            }
          }
        },
        "names": {
          "$voter": {
            ".write": true,
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30 && $voter.length < 40"
          }
        },
        "ratings": {
          "$work": {
            "$voter": {
              "$crit": {
                ".write": true,
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && $crit.matches(/^[a-z]{1,20}$/) && $voter.length < 40"
              }
            }
          }
        },
        "warmup": {
          "$q": {
            "$voter": {
              ".write": true,
              ".validate": "$voter.length < 40 && $q.matches(/^[a-z]{1,20}$/) && ((newData.isString() && newData.val().matches(/^[a-z]{1,20}$/)) || newData.hasChildren())",
              "$opt": {
                ".validate": "newData.isBoolean() && $opt.matches(/^[a-z]{1,20}$/)"
              }
            }
          }
        }
      }
    }
  }
}